{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/join/:code",
      "destination": "/register?ref=:code",
      "permanent": false
    },
    {
      "source": "/join/:code/",
      "destination": "/register?ref=:code",
      "permanent": false
    },
    {
      "source": "/join",
      "destination": "/register",
      "permanent": false
    }
  ]
}
